# ============================================================================
# THIRDHAND 🤝 — WHATSAPP AI SUPER-AGENT (.env CONFIGURATION)
# Supports both Playbook variable names and extended production settings.
# ============================================================================

# --- 1. AI Brain (Configure EITHER Gemini [Free] OR OpenAI) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- 2. Meta WhatsApp Cloud API (developers.facebook.com) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VERIFY_TOKEN=thirdhand_verify_2026
APP_SECRET=

# (Aliases automatically mapped from above if left blank)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_API_VERSION=v20.0

# --- 3. DataStax Astra DB (astra.datastax.com) ---
# Leave blank during initial local testing to use automatic local file storage!
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=default_keyspace
ASTRA_DB_COLLECTION_NAME=whatsapp_sessions
ASTRA_DB_COLLECTION=thirdhand_sessions

# --- 4. Transit, Maps & Flights (RapidAPI IRCTC, Google Maps, Amadeus) ---
RAPIDAPI_KEY=
RAPIDAPI_HOST=irctc1.p.rapidapi.com
RAPIDAPI_RAIL_HOST=irctc1.p.rapidapi.com
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test

# --- 5. Security, Browser & Smart Fallback Settings ---
SESSION_HASH_KEY=thirdhand_default_session_secret_key_change_in_prod_2026
DEMO_FALLBACK=true
SESSION_TTL_SECONDS=86400
CHAT_HISTORY_MESSAGES=10
DATABASE_TIMEOUT_SECONDS=15
DATABASE_CONFLICT_RETRIES=6
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=30
MEDIA_MAX_BYTES=20971520
PLAYWRIGHT_HEADLESS=true
BROWSER_CHANNEL=chromium
INBOX_PATH=data/inbox.sqlite3
INBOX_MAX_PENDING=1000
WEBHOOK_MAX_BYTES=1048576
BOOKING_PROFILES_PATH=config/booking_profiles.json
BROWSER_TIMEOUT_MS=30000
