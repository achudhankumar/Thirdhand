# Production configuration: no implicit demo, local storage or default secrets.
ENVIRONMENT=production
ENABLE_SIMULATOR=false
DEMO_FALLBACK=false
USE_LOCAL_MEMORY_FALLBACK=false
# Generate a private stable value of at least 32 bytes. Do not change casually.
SESSION_HASH_KEY=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=default_keyspace
ASTRA_DB_COLLECTION=thirdhand_sessions
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Gemini chat/vision does not supply Whisper transcription.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
# Explicitly select a currently supported version after checking your Meta app/docs.
META_API_VERSION=
RAPIDAPI_KEY=
RAPIDAPI_RAIL_HOST=irctc1.p.rapidapi.com
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test
INBOX_PATH=data/inbox.sqlite3
INBOX_MAX_PENDING=1000
JOB_LEASE_SECONDS=300
PROCESSING_TIMEOUT_SECONDS=240
WEBHOOK_MAX_BYTES=1048576
MEDIA_MAX_BYTES=20971520
BOOKING_PROFILES_PATH=config/booking_profiles.json
BROWSER_CHANNEL=chromium
PLAYWRIGHT_HEADLESS=true
LOG_LEVEL=INFO
# Operator-maintained existing global provider registry; never user-supplied URLs.
PROVIDER_REGISTRY=
ENABLE_OPEN_METEO=0
